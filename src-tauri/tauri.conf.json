{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FleurTerm",
  "version": "0.0.1-beta",
  "identifier": "io.fleurui.fleurterm",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FleurTerm",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "FleurUI native local terminal",
    "windows": {
      "wix": {
        "version": "0.0.1"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwRjI1Q0Y4RDkyMEU2OUEKUldTYTVpRForRnp5b051WHkyampCUWpMaytaSjFzeWRIam5wMm9GMGVUSU5vbmxCZU1YR3hPTnAK",
      "endpoints": [
        "https://github.com/Rqjqaz1122/fleuruiterm/releases/latest/download/latest.json"
      ]
    }
  }
}
